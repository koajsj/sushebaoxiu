SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_repair
DB_USERNAME=campus_repair
DB_PASSWORD=replace_with_your_local_password
# 多个来源用逗号分隔；Spring 不会自动加载 .env，启动前需要 export。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 使用 openssl rand -base64 32 生成；不要使用示例文本作为密钥。
JWT_SECRET=replace_with_random_base64_secret
JWT_TTL_SECONDS=7200

# 可选：专用图片持久目录；默认./uploads（backend目录内）
UPLOAD_DIRECTORY=./uploads
